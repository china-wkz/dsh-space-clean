{
  "name": "@local/dsh-space-clean",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "在输入框下方显示并回收 DSH / dsh-ops 临时文件占用；为 dsh-ops 0.5.0 的 %TEMP% 泄漏而做。DSH plugin: reports and reclaims stale DSH/dsh-ops temp files under the message composer.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-ops",
    "cleanup",
    "disk-space",
    "temp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/china-wkz/dsh-space-clean.git"
  },
  "bugs": {
    "url": "https://github.com/china-wkz/dsh-space-clean/issues"
  },
  "homepage": "https://github.com/china-wkz/dsh-space-clean#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
